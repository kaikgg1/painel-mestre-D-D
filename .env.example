# URL pública do projeto (segura para o front-end)
SUPABASE_URL=https://ehbngkmxwsjxuetjnztz.supabase.co

# Anon/Public key (segura para o front-end — protegida por RLS no banco)
SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# ⚠️ NUNCA preencha as variáveis abaixo em ambiente front-end / repositório
# Use apenas em scripts server-side rodando localmente (ex: seed do banco)
# SUPABASE_SERVICE_ROLE_KEY=  # bypassa RLS, dá acesso TOTAL ao banco
# DATABASE_PASSWORD=          # senha admin do Postgres
# DATABASE_URL=               # connection string completa

# Senha ATUAL da conta do Mestre (mestre123@mesa.local) — só pra rodar
# localmente os testes de `npm run auditoria` que dependem de login como
# Mestre (seções 5b-5e e 6). Sem isso definido, o script pula essas
# partes em vez de falhar. NUNCA commitar a senha real aqui nem em
# nenhum outro arquivo — só cole no seu .env local, que é gitignored.
# MESTRE_SENHA_TESTE=
